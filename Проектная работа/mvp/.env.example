# Non-secret parameters only. scripts/init_env.py creates separate files in secrets/.
MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=qwen/qwen3.7-flash
VISION_MODEL=qwen/qwen3.7-flash
# Qwen otherwise may spend the completion budget on hidden reasoning.
MODEL_REASONING_EFFORT=none
# To view traces in Jaeger: OTEL_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
OTEL_TRACES_ENDPOINT=
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
# Used only with EMBEDDING_BACKEND=remote.
EMBEDDING_BASE_URL=
QDRANT_COLLECTION=accmind_mvp_384_v1
MAX_FILE_BYTES=10485760
MAX_BATCH_FILES=10
MAX_BATCH_BYTES=52428800
MAX_PAGES=12
REQUESTS_PER_MINUTE=10
